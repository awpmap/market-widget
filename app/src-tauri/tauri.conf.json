{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Market Widget",
  "version": "1.1.0",
  "identifier": "io.github.awpmap.marketwidget",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MW",
        "url": "index.html",
        "width": 400,
        "height": 760,
        "minWidth": 360,
        "minHeight": 420,
        "decorations": false,
        "shadow": true,
        "resizable": true,
        "visible": false,
        "center": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,CalculateNativeWinOcclusion --disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "awpmap",
    "shortDescription": "Market Widget",
    "longDescription": "A small market widget with portfolio summary, sector heatmap and dip alerts. Information only; it never trades.",
    "copyright": "Info only. Not investment advice.",
    "category": "Finance",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "template": "installer/installer.nsi",
        "installerIcon": "icons/icon.ico",
        "sidebarImage": "installer/sidebar.bmp",
        "headerImage": "installer/header.bmp"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
