{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "mw-main",
  "description": "What the MW Lab page may ask the shell to do: window controls, toasts, start with Windows, open links. Tauri matches remote pages by origin only (a path pattern such as /market-widget/lab/* silently blocks every command), so this is the narrowest rule that works; the launcher only ever opens /market-widget/lab/.",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "https://awpmap.github.io/*"
    ]
  },
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-unminimize",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-set-always-on-top",
    "core:window:allow-is-always-on-top",
    "notification:default",
    "autostart:default",
    "opener:default",
    "allow-shell-state",
    "allow-shell-set",
    "allow-shell-hide",
    "allow-shell-quit",
    "allow-shell-tray",
    "allow-shell-notify",
    "allow-shell-alive",
    "allow-shell-log",
    "allow-shell-logs",
    "allow-shell-open-logs"
  ]
}
