{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MW Lab",
  "version": "1.3.1",
  "identifier": "io.github.awpmap.marketwidget.lab",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MW Lab",
        "url": "index.html",
        "width": 400,
        "height": 760,
        "minWidth": 360,
        "minHeight": 420,
        "decorations": false,
        "shadow": true,
        "resizable": true,
        "visible": false,
        "backgroundColor": "#0e1116",
        "center": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,CalculateNativeWinOcclusion --disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost https://awpmap.github.io; object-src 'none'; base-uri 'none'",
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "awpmap",
    "shortDescription": "MW Lab (test copy of Market Widget)",
    "longDescription": "Test copy of Market Widget that installs next to the real one. A small market widget with portfolio summary, sector heatmap and dip alerts. Information only; it never trades.",
    "copyright": "Info only. Not investment advice.",
    "category": "Finance",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "template": "installer/installer.nsi",
        "installerIcon": "icons/icon.ico",
        "sidebarImage": "installer/sidebar.bmp",
        "headerImage": "installer/header.bmp"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
